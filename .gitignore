# Qt Creator / qmake build output (shadow builds)
/build/
/build-*/
.qmake.stash
*.pro.user.*
.qtc_clangd/

# Installer staging + InnoSetup output (generated by install_stage.bat)
/AmigaED_install/install_src/
/AmigaED_install/Output/

# Debian / AppImage packaging output
/Debian/*.deb
/AppImage/*.AppImage
*.pro.user

# Python bytecode (docbuild scripts)
__pycache__/
*.pyc

# Qt Creator per-user settings
.qtcreator/

# Amiga build artifacts in examples/projects
*.o
*.lnk

# AmigaED job folder (start in emulator) - per machine, never versioned
AmigaED-Jobs/
