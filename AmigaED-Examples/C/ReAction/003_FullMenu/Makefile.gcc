# Auto-generated by AmigaED - regenerated automatically whenever a
# file is added to or removed from the project "FullMenu", and
# immediately before every build. Hand-edit this freely: AmigaED detects
# changes made outside itself and leaves this file untouched from then on -
# delete it to let AmigaED generate and manage it again.
# Toolchain: m68k-amigaos-gcc
# CCARGS includes the toolchain's configured Prefs baseline; CFLAGS/LDFLAGS
# hold this project's own extra options, with anything already in CCARGS removed.

CC      = D:/amiga-gcc/bin/m68k-amigaos-gcc.exe
TARGET  = FullMenu
SRCS    = FullMenu.c
OBJS    = FullMenu.o
CCARGS  = -Wall -s  # must stay the first thing after $(CC) - see comment above
CFLAGS  = 
LDFLAGS = -lamiga -noixemul

.PHONY: all clean

all: $(TARGET)

$(TARGET): $(OBJS)
	$(CC) $(CCARGS) $(OBJS) $(LDFLAGS) -o $(TARGET)

%.o: %.c
	$(CC) $(CCARGS) $(CFLAGS) -c $< -o $@

clean:
	-cmd /c if exist "FullMenu.o" del /Q "FullMenu.o"
	-cmd /c if exist "FullMenu" del /Q "FullMenu"
