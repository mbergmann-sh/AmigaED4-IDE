# FS-UAE configuration - Amiga 500 (68020/68881, ECS Agnus+Denise)
# Kickstart 1.3, three mounted directory hard drives (WB13/Work13/Code)
# and an empty floppy drive.
#
# All paths can be either absolute, or start with ~/ or $HOME/ to refer
# to the user's home directory - see https://fs-uae.net/configuration-files

[config]

# --- Base machine ---
amiga_model  = A500
kickstart_file = ~/FS-UAE/Kickstarts/kick13.rom

# --- CPU / FPU ---
# 68020 confirmed working; the original 68030 attempt showed garbled
# text, but that turned out to be an unrelated kick13.rom problem
# (wrong file, not actually a CPU-emulation issue) - worth re-testing
# 68030 again now that the ROM itself is confirmed OK.
cpu = 68020
fpu = 68881

# --- Chipset ---
# ecs = "Full ECS" (both ECS Agnus and ECS Denise). Use ecs_agnus or
# ecs_denise instead if you only want one of the two chips upgraded.
chipset = ecs

# --- Memory ---
chip_memory = 1024
# 4 MB doesn't fit FS-UAE's slow_memory range (max 1792 KB) - using
# fast_memory instead, matching how a real A500 accelerator card of
# this class would actually add its RAM.
fast_memory = 4096

# --- Hard drives (mounted directories) ---
# hard_drive_0 -> DH0, hard_drive_1 -> DH1, hard_drive_2 -> DH2
hard_drive_0       = ~/FS-UAE/Hard Drives/wb13/Workbench13
hard_drive_0_label = Workbench

hard_drive_1       = ~/FS-UAE/Hard Drives/wb13/Work13
hard_drive_1_label = Work

hard_drive_2       = ~/Projekte/AMIGA
hard_drive_2_label = Code

# --- Floppy ---
# Empty drive - no disk inserted.
floppy_drive_0 =

# --- Mouse / input grab ---
# You were seeing both the host and the Amiga mouse cursor at once,
# drifting apart - the classic symptom of "seamless" mouse_integration
# mode overriding normal input grabbing (it forces
# automatic_input_grab=0 as a side effect). Setting all three options
# explicitly removes any doubt about which mode is actually active:
# a single, properly grabbed Amiga cursor, captured right on startup.
mouse_integration    = 0
initial_input_grab   = 1
automatic_input_grab = 1

# --- Clipboard / clock / floppy sound ---
# Shares the clipboard between host and Amiga (needs an app that opens
# clipboard.device on the Amiga side too - e.g. a text editor's own
# Cut/Copy/Paste - to actually use it, this only enables the emulator
# side of the exchange).
clipboard_sharing = 1

# MSM6242B is the real RTC chip used in A500/500+/600/1200/2000 - lets
# the emulated Amiga read the current time automatically from the host.
# Note: A500 already auto-enables this ("auto", the default) once a
# memory expansion is present, which fast_memory above already does -
# set explicitly here anyway to remove any doubt. If it doesn't take
# effect, the next thing to try is uae_chipset_compatible = - (see
# https://fs-uae.net/docs/options/uae-rtc/ for why).
uae_rtc = MSM6242B

# No audible drive click (or any other floppy sound) for the one
# floppy drive configured above.
floppy_drive_0_sounds = off
