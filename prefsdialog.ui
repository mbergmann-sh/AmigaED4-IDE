     <widget class="QWidget" name="tabVamos">
      <attribute name="title">
       <string>vamos</string>
      </attribute>
      <attribute name="toolTip">
       <string>vamos (amitools) - runs AmigaOS Shell programs directly on this computer</string>
      </attribute>
      <layout class="QGridLayout" name="gridLayout_vamosOuter">
       <item row="0" column="0">
        <layout class="QGridLayout" name="gridLayout_vamos">
         <item row="0" column="0">
          <widget class="QLabel" name="label_vamosCommand">
           <property name="text">
            <string>vamos command:</string>
           </property>
          </widget>
         </item>
         <item row="0" column="1" colspan="2">
          <widget class="QLineEdit" name="lineEdit_vamosCommand">
           <property name="toolTip">
            <string>How AmigaED starts vamos (amitools). Linux/macOS: e.g. &quot;vamos&quot; or the full path to it. Windows: vamos runs inside WSL, e.g. &quot;wsl ~/amitools-venv/bin/vamos&quot;. Program and arguments are split like a shell command line.</string>
           </property>
           <property name="placeholderText">
            <string>vamos</string>
           </property>
          </widget>
         </item>
         <item row="1" column="0" colspan="3">
          <widget class="QCheckBox" name="checkBox_vamosWSL">
           <property name="toolTip">
            <string>vamos runs inside WSL: AmigaED translates Windows paths (D:\x\y) into WSL paths (/mnt/d/x/y) and quotes all arguments for the WSL shell.</string>
           </property>
           <property name="text">
            <string>vamos runs inside WSL (translate Windows paths)</string>
           </property>
          </widget>
         </item>
         <item row="2" column="0">
          <widget class="QLabel" name="label_vamosWorkbenchDir">
           <property name="text">
            <string>Workbench folder:</string>
           </property>
          </widget>
         </item>
         <item row="2" column="1">
          <widget class="QLineEdit" name="lineEdit_vamosWorkbenchDir">
           <property name="toolTip">
            <string>Optional: host folder of your emulator's &quot;Workbench&quot; partition. Mounted in vamos as volume workbench: (the same folder your emulator uses). Leave empty if your vamos command already mounts it.</string>
           </property>
          </widget>
         </item>
         <item row="2" column="2">
          <widget class="QPushButton" name="btn_getVamosWorkbenchDir">
           <property name="maximumSize">
            <size>
             <width>31</width>
             <height>25</height>
            </size>
           </property>
           <property name="text">
            <string/>
           </property>
           <property name="icon">
            <iconset resource="application.qrc">
             <normaloff>:/images/new.png</normaloff>:/images/new.png</iconset>
           </property>
