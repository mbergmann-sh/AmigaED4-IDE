           <property name="text">
            <string>Extra vamos options:</string>
           </property>
          </widget>
         </item>
         <item row="4" column="1" colspan="2">
          <widget class="QLineEdit" name="lineEdit_vamosOpts">
           <property name="toolTip">
            <string>Added to every vamos call before the program, e.g. &quot;-m 8000 -s 256&quot; (8 MB RAM, 256 KB stack - what SAS/C needs; vamos refuses much more than ~8 MB).</string>
           </property>
           <property name="placeholderText">
            <string>-m 8000 -s 256</string>
           </property>
          </widget>
         </item>
         <item row="5" column="0">
