           </property>
           <property name="placeholderText">
            <string>work:MUI</string>
           </property>
          </widget>
         </item>
         <item row="7" column="0" colspan="3">
          <widget class="QLabel" name="label_vamosInfo">
           <property name="text">
            <string>vamos runs AmigaOS Shell programs directly on this computer - right-click an executable in the project tree and choose &quot;Run in vamos&quot;. It has no windows/graphics and its IEEE math emulation is unreliable: test GUI and floating-point programs in the emulator.</string>
           </property>
           <property name="wordWrap">
            <bool>true</bool>
           </property>
          </widget>
         </item>
