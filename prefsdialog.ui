         </item>
         <item row="3" column="0">
          <widget class="QLabel" name="label_vamosWorkDir">
           <property name="text">
            <string>Work folder:</string>
           </property>
          </widget>
         </item>
         <item row="3" column="1">
          <widget class="QLineEdit" name="lineEdit_vamosWorkDir">
           <property name="toolTip">
            <string>Optional: host folder of your emulator's &quot;Work&quot; partition. Mounted in vamos as volume work:. Leave empty if your vamos command already mounts it.</string>
           </property>
          </widget>
